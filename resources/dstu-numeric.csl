<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="uk-UA" page-range-format="expanded">
  <info>
    <title>Project numeric citations for DSTU reports</title>
    <id>https://local.invalid/styles/md2dstu-numeric</id>
    <link href="https://local.invalid/styles/md2dstu-numeric" rel="self"/>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Numeric references following the principal DSTU 3008:2015, DSTU GOST 7.1:2006, and DSTU 8302:2015 bibliography rules.</summary>
    <updated>2026-10-24T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="uk">
    <terms>
      <term name="edition" form="short">вид.</term>
      <term name="editor" form="verb-short">
        <single>за ред.</single>
        <multiple>за ред.</multiple>
      </term>
      <term name="translator" form="verb-short">
        <single>пер.</single>
        <multiple>пер.</multiple>
      </term>
      <term name="page" form="short">
        <single>С.</single>
        <multiple>С.</multiple>
      </term>
      <term name="volume" form="short">Т.</term>
      <term name="issue" form="short">№</term>
      <term name="et-al">та ін.</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " delimiter-precedes-last="never" et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="never"/>
      <et-al font-style="normal"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " delimiter-precedes-last="never"/>
        </names>
        <text variable="publisher"/>
      </substitute>
    </names>
  </macro>

  <macro name="contributors">
    <names variable="editor translator" delimiter="; ">
      <label form="verb-short" suffix=" "/>
      <name initialize-with=". " delimiter=", " delimiter-precedes-last="never"/>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="issued-date">
    <date variable="issued">
      <date-part name="day" form="numeric-leading-zeros" suffix="."/>
      <date-part name="month" form="numeric-leading-zeros" suffix="."/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="accessed">
    <date variable="accessed" prefix="(дата звернення: " suffix=")">
      <date-part name="day" form="numeric-leading-zeros" suffix="."/>
      <date-part name="month" form="numeric-leading-zeros" suffix="."/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <group delimiter=" : ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="issued-year"/>
    </group>
  </macro>

  <macro name="report-publisher">
    <group delimiter=", ">
      <group delimiter=" : ">
        <text variable="publisher-place"/>
        <choose>
          <if variable="publisher"><text variable="publisher"/></if>
          <else><text variable="authority"/></else>
        </choose>
      </group>
      <text macro="issued-year"/>
    </group>
  </macro>

  <macro name="volume-issue">
    <group delimiter=", ">
      <group delimiter=" ">
        <text term="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <text term="issue" form="short"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>

  <macro name="pages">
    <choose>
      <if type="book report thesis manuscript" match="any">
        <group delimiter=" ">
          <text variable="number-of-pages"/>
          <text value="с."/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text term="page" form="short"/>
          <text variable="page"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="identifiers">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: "/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL" prefix="URL: "/>
          <text macro="accessed"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="book">
    <group delimiter=". ">
      <text macro="author"/>
      <group delimiter=" / ">
        <group delimiter=" : ">
          <text variable="title"/>
          <text variable="genre"/>
        </group>
        <text macro="contributors"/>
      </group>
      <text macro="edition"/>
      <text macro="publisher"/>
      <text macro="pages"/>
      <text variable="ISBN" prefix="ISBN "/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <macro name="report">
    <group delimiter=". ">
      <text macro="author"/>
      <group delimiter=" / ">
        <group delimiter=" : ">
          <text variable="title"/>
          <text variable="genre"/>
        </group>
        <text macro="contributors"/>
      </group>
      <text variable="number" prefix="№ "/>
      <text macro="report-publisher"/>
      <text macro="pages"/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <macro name="chapter">
    <group delimiter=". ">
      <text macro="author"/>
      <text variable="title"/>
      <group delimiter=" / ">
        <text variable="container-title"/>
        <text macro="contributors"/>
      </group>
      <text macro="publisher"/>
      <text macro="volume-issue"/>
      <text macro="pages"/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <macro name="article">
    <group delimiter=". ">
      <text macro="author"/>
      <text variable="title"/>
      <text variable="container-title"/>
      <text macro="issued-year"/>
      <text macro="volume-issue"/>
      <text macro="pages"/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <macro name="conference-paper">
    <group delimiter=". ">
      <text macro="author"/>
      <text variable="title"/>
      <group delimiter=": ">
        <text variable="event-title"/>
        <text variable="container-title"/>
      </group>
      <text macro="contributors"/>
      <text macro="publisher"/>
      <text macro="pages"/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <macro name="legislation">
    <group delimiter=". ">
      <group delimiter=" : ">
        <text variable="title"/>
        <group delimiter=" ">
          <text variable="genre"/>
          <text macro="issued-date" prefix="від "/>
          <text variable="number" prefix="№ "/>
        </group>
      </group>
      <text variable="container-title"/>
      <text macro="issued-year"/>
      <text macro="volume-issue"/>
      <text macro="pages"/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <macro name="webpage">
    <group delimiter=". ">
      <text macro="author"/>
      <text variable="title"/>
      <text variable="container-title"/>
      <text macro="issued-year"/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <macro name="generic">
    <group delimiter=". ">
      <text macro="author"/>
      <text variable="title"/>
      <text variable="container-title"/>
      <text macro="contributors"/>
      <text macro="edition"/>
      <text macro="publisher"/>
      <text macro="volume-issue"/>
      <text macro="pages"/>
      <text macro="identifiers"/>
    </group>
  </macro>

  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
      <group prefix=", " delimiter=" ">
        <label variable="locator" form="short"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>

  <bibliography entry-spacing="0">
    <sort><key variable="citation-number"/></sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="book"><text macro="book"/></if>
        <else-if type="report thesis manuscript" match="any"><text macro="report"/></else-if>
        <else-if type="chapter entry-encyclopedia entry-dictionary" match="any"><text macro="chapter"/></else-if>
        <else-if type="article-journal article-magazine article-newspaper" match="any"><text macro="article"/></else-if>
        <else-if type="paper-conference"><text macro="conference-paper"/></else-if>
        <else-if type="legislation legal_case treaty bill" match="any"><text macro="legislation"/></else-if>
        <else-if type="webpage post-weblog post"><text macro="webpage"/></else-if>
        <else><text macro="generic"/></else>
      </choose>
    </layout>
  </bibliography>
</style>
